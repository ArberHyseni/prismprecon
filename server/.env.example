# Copy to server/.env for local dev. In production set these in
# cPanel -> Setup Node.js App -> Environment variables.
PORT=3001

# Contact form email (use the cPanel mailbox, e.g. info@prismprecon.com)
SMTP_HOST=mail.prismprecon.com
SMTP_PORT=465
SMTP_USER=info@prismprecon.com
SMTP_PASS=
CONTACT_TO=info@prismprecon.com
