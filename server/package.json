{
  "name": "@prismprecon/server",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --minify --sourcemap --outfile=dist/app.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
